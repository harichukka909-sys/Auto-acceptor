import React, { useMemo, useState } from 'react';
import {
  StyleSheet,
  Text,
  View,
  SafeAreaView,
  ScrollView,
  Pressable,
  Alert,
  Dimensions,
} from 'react-native';
import { LinearGradient } from 'expo-linear-gradient';
import { mockTrips, driverProfile, dashboardStats } from './src/data/mockData';
import { acceptTrip, rejectTrip, toggleDriverOnline } from './src/lib/mockApi';

const { width } = Dimensions.get('window');

export default function App() {
  const [driver, setDriver] = useState(driverProfile);
  const [trips, setTrips] = useState(mockTrips);
  const [autoAccept, setAutoAccept] = useState(driver.autoAcceptEnabled);

  const stats = useMemo(() => {
    return [
      { label: 'Trips', value: String(dashboardStats.totalTrips) },
      { label: 'Today', value: `₹${dashboardStats.todayEarnings}` },
      { label: 'Completed', value: String(dashboardStats.completedTrips) },
      { label: 'Cancelled', value: String(dashboardStats.cancelledTrips) }
    ];
  }, [driver]);

  const handleToggleOnline = async () => {
    const updated = await toggleDriverOnline(driver.id);
    setDriver(updated);
  };

  const handleAccept = async (tripId) => {
    const result = await acceptTrip(tripId, driver.id);
    setTrips((current) =>
      current.map((trip) => (trip.id === tripId ? { ...trip, status: 'accepted' } : trip))
    );
    Alert.alert('Trip Accepted', `${result.trip.customerName} is now assigned to you.`);
  };

  const handleReject = async (tripId) => {
    const result = await rejectTrip(tripId);
    setTrips((current) =>
      current.map((trip) => (trip.id === tripId ? { ...trip, status: 'cancelled' } : trip))
    );
    Alert.alert('Trip Rejected', `${result.trip.customerName} was rejected.`);
  };

  const handleToggleAutoAccept = () => {
    setAutoAccept((value) => !value);
    Alert.alert('Auto Accept', `${!autoAccept ? 'Enabled' : 'Disabled'} for matching trips.`);
  };

  return (
    <SafeAreaView style={styles.safeArea}>
      <LinearGradient colors={['#09090B', '#111827', '#FEA116']} style={styles.container}>
        <ScrollView contentContainerStyle={styles.content}>
          <View style={styles.headerRow}>
            <View>
              <Text style={styles.greeting}>Welcome back</Text>
              <Text style={styles.driverName}>{driver.name}</Text>
            </View>
            <Pressable
              style={[styles.onlineToggle, driver.isOnline ? styles.onlineActive : styles.onlineInactive]}
              onPress={handleToggleOnline}
            >
              <Text style={styles.onlineText}>{driver.isOnline ? 'Online' : 'Offline'}</Text>
            </Pressable>
          </View>

          <View style={styles.cardRow}>
            {stats.map((item) => (
              <View key={item.label} style={styles.statCard}>
                <Text style={styles.statValue}>{item.value}</Text>
                <Text style={styles.statLabel}>{item.label}</Text>
              </View>
            ))}
          </View>

          <View style={styles.dashboardPanel}>
            <View style={styles.panelHeader}>
              <Text style={styles.panelTitle}>Auto Accept</Text>
              <Pressable
                style={[styles.switch, autoAccept ? styles.switchActive : styles.switchInactive]}
                onPress={handleToggleAutoAccept}
              >
                <Text style={styles.switchText}>{autoAccept ? 'On' : 'Off'}</Text>
              </Pressable>
            </View>

            <Text style={styles.ruleText}>Min fare: ₹{driver.autoAcceptRules.minFare}</Text>
            <Text style={styles.ruleText}>Max distance: {driver.autoAcceptRules.maxDistanceKm} km</Text>
            <Text style={styles.ruleText}>Pickup range: {driver.autoAcceptRules.pickupDistanceKm} km</Text>
            <Text style={styles.ruleText}>Preferred area: {driver.autoAcceptRules.preferredAreas.join(', ')}</Text>
          </View>

          <View style={styles.sectionHeaderRow}>
            <Text style={styles.sectionTitle}>Incoming Requests</Text>
            <Text style={styles.badge}>{trips.filter((trip) => trip.status === 'pending').length} active</Text>
          </View>

          {trips.map((trip) => (
            <View key={trip.id} style={styles.tripCard}>
              <View style={styles.tripHeader}>
                <Text style={styles.tripCustomer}>{trip.customerName}</Text>
                <Text style={styles.tripFare}>₹{trip.fare}</Text>
              </View>

              <Text style={styles.tripMeta}>Pickup: {trip.pickupAddress}</Text>
              <Text style={styles.tripMeta}>Drop: {trip.dropAddress}</Text>
              <Text style={styles.tripMeta}>Distance: {trip.distanceKm} km • Duration: {trip.durationMin} min</Text>

              <View style={styles.actionRow}>
                <Pressable style={styles.acceptButton} onPress={() => handleAccept(trip.id)}>
                  <Text style={styles.actionText}>Accept</Text>
                </Pressable>
                <Pressable style={styles.rejectButton} onPress={() => handleReject(trip.id)}>
                  <Text style={styles.actionText}>Reject</Text>
                </Pressable>
              </View>
            </View>
          ))}
        </ScrollView>
      </LinearGradient>
    </SafeAreaView>
  );
}

